{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prexiopa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth usa AsyncLocalStorage (node:async_hooks).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prexiopa",
      "database_id": "8b83fa76-a363-4637-b173-ce7c11456214",
      "migrations_dir": "worker/db/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // URL pública de la app, sin barra final. Ej: "https://prexiopa.example.com".
    // Google redirige a {BETTER_AUTH_URL}/api/auth/callback/google.
    "BETTER_AUTH_URL": ""
  }
  // Secrets (`npx wrangler secret put <NOMBRE>`), no van en este archivo:
  // BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET y
  // ALLOWED_EMAILS (correos separados por coma que pueden entrar).
}
